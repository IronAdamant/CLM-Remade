{
  "modName": "CLM",
  "displayName": "Custom Legendary Modifications",
  "minMcmVersion": 2,
  "content": [
    {
      "text": "Custom Legendary Modifications Remade",
      "type": "section"
    },
    {
      "text": "Settings: crafting mode, OP legendaries, variants, Legendary Picker, loot drop rate.",
      "type": "text"
    },
    {
      "text": "CLM Perks / Cheat Perks: add or remove the perks of the perk holotape.",
      "type": "text"
    }
  ],
  "pages": [
    {
      "pageDisplayName": "Settings",
      "content": [
        {
          "text": "<font color='#AAAAAA'>These are the same settings as the \"CLM Setting\" items you can make at a chemistry station: changing one here gives or takes that item, and this page always shows what you carry.</font>",
          "type": "text"
        },
        {
          "text": "Crafting",
          "type": "section"
        },
        {
          "text": "Crafting mode",
          "type": "dropdown",
          "id": "iCrafting:Settings",
          "help": "Costly: legendaries cost components. Free: they cost nothing. Loot mode: they drop from enemies instead (carry a CLM holotape to craft its family; OP ones need a Legendary Core).",
          "valueOptions": {
            "options": [
              "Costly",
              "Free",
              "Loot mode"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "Loot mode drop rate",
          "type": "dropdown",
          "id": "iDropRate:Settings",
          "help": "How often loot mode drops legendaries. Standard: common 3%, uncommon 1%, rare 0.3%, OP 0.1% per kill.",
          "valueOptions": {
            "options": [
              "Low",
              "Standard",
              "Higher"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "What the workbench shows",
          "type": "section"
        },
        {
          "text": "Show OP legendaries",
          "type": "switcher",
          "id": "bShowOP:Settings",
          "help": "Also show the overpowered legendaries.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "text": "Show variants",
          "type": "switcher",
          "id": "bShowVariants:Settings",
          "help": "Show every strength and variant of each legendary.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "text": "Hide perk-style legendaries",
          "type": "switcher",
          "id": "bHidePerk:Settings",
          "help": "Hide the legendaries that work like perks (Jumpy, Speedy, Nimble...).",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "text": "Hide spawning legendaries",
          "type": "switcher",
          "id": "bHideSpawn:Settings",
          "help": "Hide the legendaries that spawn creatures and people.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "text": "Picker mode",
          "type": "switcher",
          "id": "bPicker:Settings",
          "help": "The workbench shows only the families you pick at a chemistry station (CLM Armour / Spawns / Weapon categories).",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "text": "Holotapes",
          "type": "section"
        },
        {
          "text": "Holotapes",
          "type": "switcher",
          "id": "bHolotapes:Settings",
          "help": "This menu replaces the configuration and perk holotapes. Turn this on to get both holotapes (and their recipes) back anyway.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        }
      ]
    },
