Scriptname A1ALMSettingsTerminalScript extends Terminal
{CLM settings holotape (PC/Xbox): gives and takes the setting items - the same items crafted at the
chemistry station, which are what every recipe checks. Generated by tools/config/settings.py.}

MiscObject[] Property Settings Auto Const Mandatory
{In the order: free, loot, op, variants, noperk, nospawn, low, high}
int Property Page = 0 Auto Const
{0 = main configuration menu, 1 = loot drop rate menu}

Event OnMenuItemRun(int auiMenuItemID, ObjectReference akTerminalRef)
	If Page == 0
		If auiMenuItemID == 1
			SetSetting(0, true)
			SetSetting(1, false)
			Debug.Notification("CLM: Crafting: Free")
		ElseIf auiMenuItemID == 2
			SetSetting(0, false)
			SetSetting(1, false)
			Debug.Notification("CLM: Crafting: Costly")
		ElseIf auiMenuItemID == 3
			SetSetting(1, true)
			SetSetting(0, false)
			Debug.Notification("CLM: Loot version - Hunt for legendaries")
		ElseIf auiMenuItemID == 4
			SetSetting(2, true)
			Debug.Notification("CLM: Show OP legendaries")
		ElseIf auiMenuItemID == 5
			SetSetting(2, false)
			Debug.Notification("CLM: Balanced only - hide OP legendaries")
		ElseIf auiMenuItemID == 6
			SetSetting(3, true)
			Debug.Notification("CLM: Show every variant")
		ElseIf auiMenuItemID == 7
			SetSetting(3, false)
			Debug.Notification("CLM: Hide variants")
		ElseIf auiMenuItemID == 8
			SetSetting(4, true)
			Debug.Notification("CLM: Hide perk-style legendaries")
		ElseIf auiMenuItemID == 9
			SetSetting(4, false)
			Debug.Notification("CLM: Show perk-style legendaries")
		ElseIf auiMenuItemID == 10
			SetSetting(5, true)
			Debug.Notification("CLM: Hide spawning legendaries")
		ElseIf auiMenuItemID == 11
			SetSetting(5, false)
			Debug.Notification("CLM: Show spawning legendaries")
		EndIf
	ElseIf Page == 1
		If auiMenuItemID == 1
			SetSetting(6, true)
			SetSetting(7, false)
			Debug.Notification("CLM: Low - extremely rare drops")
		ElseIf auiMenuItemID == 2
			SetSetting(6, false)
			SetSetting(7, false)
			Debug.Notification("CLM: Standard - the intended rate")
		ElseIf auiMenuItemID == 3
			SetSetting(7, true)
			SetSetting(6, false)
			Debug.Notification("CLM: Higher - generous drops")
		EndIf
	EndIf
EndEvent

Function SetSetting(int aiIndex, bool abOn)
	Actor player = Game.GetPlayer()
	int n = player.GetItemCount(Settings[aiIndex])
	If abOn && n == 0
		player.AddItem(Settings[aiIndex], 1, true)
	ElseIf !abOn && n > 0
		player.RemoveItem(Settings[aiIndex], n, true)
	EndIf
EndFunction
