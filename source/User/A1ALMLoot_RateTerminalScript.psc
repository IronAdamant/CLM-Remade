Scriptname A1ALMLoot_RateTerminalScript extends Terminal
{CLM loot mode: the drop-rate menu. Items 1-3 set the chance-none globals that gate the drop lists.
Generated by tools/loot/generate.py from its RATES table - edit that, not this file.}

GlobalVariable[] Property Outer Auto Const Mandatory
{Outer gates, in the order: Common, Uncommon, Rare, OP, Holotape, Catalyst}
GlobalVariable[] Property Inner Auto Const Mandatory
GlobalVariable Property Rate Auto Const Mandatory
{0 Low, 1 Standard, 2 Higher}

Event OnMenuItemRun(int auiMenuItemID, ObjectReference akTerminalRef)
	If auiMenuItemID == 1
		Outer[0].SetValue(90)
		Inner[0].SetValue(95)
		Outer[1].SetValue(90)
		Inner[1].SetValue(98)
		Outer[2].SetValue(95)
		Inner[2].SetValue(99)
		Outer[3].SetValue(99)
		Inner[3].SetValue(99)
		Outer[4].SetValue(90)
		Inner[4].SetValue(99)
		Outer[5].SetValue(98)
		Inner[5].SetValue(99)
		Rate.SetValue(0)
		Debug.Notification("CLM loot drop rate: Low")
	ElseIf auiMenuItemID == 2
		Outer[0].SetValue(97)
		Inner[0].SetValue(0)
		Outer[1].SetValue(99)
		Inner[1].SetValue(0)
		Outer[2].SetValue(90)
		Inner[2].SetValue(97)
		Outer[3].SetValue(90)
		Inner[3].SetValue(99)
		Outer[4].SetValue(90)
		Inner[4].SetValue(95)
		Outer[5].SetValue(90)
		Inner[5].SetValue(98)
		Rate.SetValue(1)
		Debug.Notification("CLM loot drop rate: Standard")
	ElseIf auiMenuItemID == 3
		Outer[0].SetValue(75)
		Inner[0].SetValue(0)
		Outer[1].SetValue(85)
		Inner[1].SetValue(0)
		Outer[2].SetValue(92)
		Inner[2].SetValue(0)
		Outer[3].SetValue(95)
		Inner[3].SetValue(0)
		Outer[4].SetValue(95)
		Inner[4].SetValue(0)
		Outer[5].SetValue(97)
		Inner[5].SetValue(0)
		Rate.SetValue(2)
		Debug.Notification("CLM loot drop rate: Higher")
	EndIf
EndEvent
